% ---- kutular
% tanım, teorem/formül, tahta (derste tahtaya yazılan), dikkat (sık hatalar), bilgi, formül özeti
\newtcolorbox{tanim}[1][]{enhanced,breakable,colback=acik,colframe=ana,
  title={Tanım\if\relax\detokenize{#1}\relax\else{} -- #1\fi},fonttitle=\bfseries\small,left=4pt,right=4pt,top=3pt,bottom=3pt}
\newtcolorbox{teorem}[1][]{enhanced,breakable,colback=violet!4,colframe=mor,
  title={Teorem / Formül\if\relax\detokenize{#1}\relax\else{} -- #1\fi},fonttitle=\bfseries\small,left=4pt,right=4pt,top=3pt,bottom=3pt}
\newtcolorbox{tahta}[1][]{enhanced,breakable,colback=red!3,colframe=vurgu,
  title={Derste tahtada\if\relax\detokenize{#1}\relax\else{} #1\fi},fonttitle=\bfseries\small,
  left=4pt,right=4pt,top=3pt,bottom=3pt}
\newtcolorbox{dikkat}[1][Sık yapılan hatalar]{enhanced,breakable,colback=orange!5,colframe=turuncu,
  title={#1},fonttitle=\bfseries\small,left=4pt,right=4pt,top=3pt,bottom=3pt}
\newtcolorbox{bilgi}[1][Bilgi]{enhanced,breakable,colback=acik,colframe=ana,
  title={#1},fonttitle=\bfseries\small,left=4pt,right=4pt,top=3pt,bottom=3pt}
\newtcolorbox{ozet}[1][Özet ve formül kutusu]{enhanced,breakable,colback=yellow!6,colframe=turuncu!80!black,
  title={#1},fonttitle=\bfseries,left=6pt,right=6pt,top=4pt,bottom=4pt}
\newtcolorbox{soru}[1][]{enhanced,breakable,colback=white,colframe=ana!70,
  title={#1},fonttitle=\bfseries,left=5pt,right=5pt,top=4pt,bottom=4pt}
\newtcolorbox{cevap}[1][Çözüm]{enhanced,breakable,colback=green!3,colframe=yesil,
  title={#1},fonttitle=\bfseries\small,left=5pt,right=5pt,top=4pt,bottom=4pt}
\newcommand{\foto}[1]{{\small[foto: #1]}}
\newcommand{\vurg}[1]{\textbf{\color{vurgu}#1}}
\newcommand{\ekal}{\textbf{\color{turuncu}[Ek alıştırma]}~}
\newcommand{\okunamadi}[1]{\textit{\color{vurgu}(fotoğrafta okunamadı: #1)}}
\newcommand{\kart}[1]{\par\needspace{8\baselineskip}\bigskip\noindent{\large\bfseries\color{ana}#1}\par\nopagebreak\smallskip\noindent}

